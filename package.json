{
  "name": "dolphino",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node --watch backend/src/server.mjs",
    "start": "node backend/src/server.mjs",
    "test": "node --test --test-concurrency=1 backend/test/*.test.mjs frontend/test/*.test.mjs",
    "build": "npm run build --workspace frontend",
    "seed": "node backend/src/utils/seed.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "migrate": "node backend/src/utils/migrate.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:browser": "node scripts/browser-check.mjs",
    "format:check": "prettier --check .",
    "test:browser:enhancements": "node scripts/browser-enhancements.mjs",
    "test:browser:auth": "node scripts/browser-auth.mjs",
    "recover-user": "node scripts/recover-user.mjs",
    "test:browser:assistant": "node scripts/browser-assistant.mjs",
    "test:browser:brand": "node scripts/browser-brand.mjs",
    "test:browser:integration-settings": "node scripts/browser-integration-settings.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "test:browser:simplefin": "node scripts/browser-simplefin.mjs",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "test:browser:theme": "node scripts/browser-theme.mjs",
    "test:browser:settings-mocked": "node frontend/test/integration-settings.browser.mjs",
    "test:browser:workspace": "node frontend/test/workspace.browser.mjs",
    "test:browser:bedrock-models": "node scripts/browser-bedrock-models.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1143.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1143.0",
    "@aws-sdk/client-sts": "^3.1143.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "rayo": "1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=24"
  }
}
