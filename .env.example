# Copy to .env; chmod 600 .env. Never commit real values.
# demo and live data require distinct databases. Demo fixtures are fictional.
DOLPHINO_MODE=demo
PORT=3001
APP_ORIGIN=http://localhost:3001

# The host address the application port is published on. The default keeps it
# on loopback, which is what a reverse proxy or cloudflared on this host
# reaches. Set 0.0.0.0 to answer from the network directly, remembering that
# the application speaks plain HTTP and Docker publishes a port past the
# host firewall's INPUT rules.
#APP_BIND=

# External database: use its DNS name (matching the TLS certificate), or an IP.
# Bundled Compose replaces PGHOST/PGPORT with db/5432; identity stays explicit.
PGHOST=postgres.example.home
PGPORT=5432
PGDATABASE=dolphino_demo
PGUSER=dolphino
PGPASSWORD=CHANGE_ME
# Alternative: absolute readable password file; leave PGPASSWORD empty.
# Bundled: /run/postgres-secrets/password from ./postgres-secrets/password.
# Use a single-line bundled password with at most one final LF/CRLF.
PGPASSWORD_FILE=

# Off-host PostgreSQL requires an explicit choice. Recommended: verify-full.
# verify-full: encryption + certificate chain and PGHOST identity verification.
# require: encryption ONLY, without server authentication; emits a warning.
# disable: deliberate plain TCP. No mode falls back to another on failure.
# Bundled PostgreSQL uses plain TCP when these TLS variables are unset.
PGSSLMODE=
# verify-full defaults to system/public roots without a custom file.
# Optional: system, or an absolute PEM CA path. Custom host path in Docker:
# add -f compose.postgres-ca.yaml to mount it read-only; see docs/deployment.md.
PGSSLROOTCERT=

# Optional exact reverse-proxy peer IPs or CIDRs, comma-separated; loopback
# is always trusted. For cloudflared -> Caddy -> app, start with Caddy's peer
# address as seen by the app, not the cloudflared host. Avoid broad subnets.
TRUST_PROXY=
# First administrator only: random bootstrap proof, removed after setup.

DOLPHINO_BOOTSTRAP_TOKEN=
DOLPHINO_BOOTSTRAP_TOKEN_FILE=

# Encryption master key: generate locally with openssl rand -base64 32.
# Required before Settings credential writes; back up separately from PostgreSQL.
APP_SECRET=
APP_SECRET_FILE=

# Live deployments require HTTPS and named administrator bootstrap.
# Configure Redbark, classification providers, assistant and notifications in
# administrator Settings. Integration values are stored only in PostgreSQL.
# Existing environment-only credentials must be re-entered there; no import
# or environment fallback is performed. APP_SECRET remains deployment-side.

# Bundled PostgreSQL only: explicit existing external volume. PGDATABASE,
# PGUSER and PGPASSWORD/PGPASSWORD_FILE above also initialize the DB container.
# New installs: create dolphino_postgres first, then set volume/db/user explicitly.
# Upgrades: retain the ACTUAL existing volume, database and user; never guess.
POSTGRES_VOLUME=

DOLPHINO_CURRENCY=AUD
DOLPHINO_TIMEZONE=Australia/Brisbane
