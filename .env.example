# Copy to .env; chmod 600 .env. Never commit real values.
# demo and live data require distinct databases. Demo fixtures are fictional.
DOLPHINO_MODE=demo
PORT=3001
APP_ORIGIN=http://localhost:3001

# The host address the application port is published on. The default keeps it
# on loopback, which is what a reverse proxy or cloudflared on this host
# reaches. Set 0.0.0.0 to answer from the network directly, remembering that
# the application speaks plain HTTP and Docker publishes a port past the
# host firewall's INPUT rules.
#APP_BIND=

DATABASE_URL=postgresql://dolphino:CHANGE_ME@YOUR_LAN_POSTGRES:5432/dolphino_demo
# Set *_FILE to read secrets from files; leave corresponding direct value empty.
DATABASE_URL_FILE=
# First administrator only: random bootstrap proof, removed after setup.

DOLPHINO_BOOTSTRAP_TOKEN=
DOLPHINO_BOOTSTRAP_TOKEN_FILE=

# Encryption master key: generate locally with openssl rand -base64 32.
# Required before Settings credential writes; back up separately from PostgreSQL.
APP_SECRET=
APP_SECRET_FILE=

# Live deployments require HTTPS and named administrator bootstrap.
# Configure Redbark, classification providers, assistant and notifications in
# administrator Settings. Integration values are stored only in PostgreSQL.
# Existing environment-only credentials must be re-entered there; no import
# or environment fallback is performed. APP_SECRET remains deployment-side.

# Used ONLY by the explicit compose.postgres.yaml override; use URL-safe hex.
POSTGRES_PASSWORD=

# Bundled PostgreSQL only: explicit existing external volume and database identity.
# New installs: create dolphino_postgres first, then set volume/db/user explicitly.
# Upgrades: retain the ACTUAL existing volume, database and user; never guess.
POSTGRES_VOLUME=
POSTGRES_DB=
POSTGRES_USER=

DOLPHINO_CURRENCY=AUD
DOLPHINO_TIMEZONE=Australia/Brisbane
